    {
      "id": 10,
      "type": "timeseries",
      "title": "MySQL 행 잠금",
      "description": "mysql-lock 시나리오에서 오릅니다",
      "datasource": {
        "type": "prometheus",
        "uid": "${amp}"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${amp}"
          },
          "expr": "sum by (db_instance) (rate(mysql_global_status_innodb_row_lock_waits[1m]))",
          "legendFormat": "row lock waits/s {{db_instance}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${amp}"
          },
          "expr": "max by (db_instance) (mysql_global_status_innodb_row_lock_current_waits)",
          "legendFormat": "current waits {{db_instance}}",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${amp}"
          },
          "expr": "max by (db_instance) (mysql_global_status_threads_running)",
          "legendFormat": "threads running {{db_instance}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "PostgreSQL 순차 스캔·세션",
      "description": "pg-slow-query(전체 스캔)에서 seq scan rows가 오릅니다",
      "datasource": {
        "type": "prometheus",
        "uid": "${amp}"
      },
      "gridPos": {
        "x": 6,
        "y": 19,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${amp}"
          },
          "expr": "sum by (db_instance) (rate(pg_stat_user_tables_seq_tup_read[1m]))",
          "legendFormat": "seq scan rows/s {{db_instance}}",
          "range": true
        },
        {
          "refId": "B",
