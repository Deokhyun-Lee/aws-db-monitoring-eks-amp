      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${amp}"
          },
          "expr": "sum by (db_instance) (mssql_active_requests_by_status{status=\"suspended\"})",
          "legendFormat": "suspended {{db_instance}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${amp}"
          },
          "expr": "sum by (db_instance) (rate(mssql_wait_stats_wait_time_ms{wait_category=\"Lock\"}[1m]))",
          "legendFormat": "LCK wait ms/s {{db_instance}}",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${amp}"
          },
          "expr": "sum by (db_instance) (rate(mssql_batch_requests[1m]))",
          "legendFormat": "batch req/s {{db_instance}}",
          "range": true
        }
